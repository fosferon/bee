# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
bee-*.tar

# Temporary files, for example, from tests.
/tmp/
.elixir_context/

# Local agent tooling and generated workspace assets stay outside source control.
#
# Named explicitly rather than as a blanket `/*` with an allowlist. That form
# ignored the ENTIRE repository root and re-included only _bmad-output, so no new
# source file could be committed without -f. It looked harmless because git never
# ignores what it already tracks, so the 34 files in lib/ and 11 in test/ kept
# working — until a new test was silently dropped from a commit (GC-4873).
/.agent/
/.agents/
/.claude/
/.factory/
/.opencode/
/.logs/
/.worktrees/
/_bmad/
/design-artifacts/
